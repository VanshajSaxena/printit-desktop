### Ping

GET http://localhost:3000/api/v1/ping HTTP/1.1
Accept: application/json


### 


### Create Vendor

POST http://localhost:3000/api/v1/vendors HTTP/1.1
Content-Type: application/json

{
  "address": "123 Main St",
  "email": "john.doe@example.com",
  "firstName": "John",
  "givenName": "Johnny",
  "lastName": "Doe"
}


### 


### Get All Vendors

GET http://localhost:3000/api/v1/vendors HTTP/1.1
Accept: application/json


### 


### Get Vendor by ID

GET http://localhost:3000/api/v1/vendors/1 HTTP/1.1
Accept: application/json


### 


### Update Vendor by ID

PATCH http://localhost:3000/api/v1/vendors/1 HTTP/1.1
Content-Type: application/json

{
  "firstName": "Jane"
}


### 


### Delete Vendor by ID

DELETE http://localhost:3000/api/v1/vendors/1 HTTP/1.1
Accept: application/json


### 


### Create Printer

POST http://localhost:3000/api/v1/printers HTTP/1.1
Content-Type: application/json

{
  "capabilities": "{ 'color': true, 'duplex': false }",
  "name": "Printer A",
  "vendorId": 1
}


### 


### Get All Printers

GET http://localhost:3000/api/v1/printers HTTP/1.1
Accept: application/json


### 


### Get Printer by ID

GET http://localhost:3000/api/v1/printers/1 HTTP/1.1
Accept: application/json


### 


### Update Printer by ID

PATCH http://localhost:3000/api/v1/printers/1 HTTP/1.1
Content-Type: application/json

{
  "name": "Updated Printer A"
}


### 


### Delete Printer by ID

DELETE http://localhost:3000/api/v1/printers/1 HTTP/1.1
Accept: application/json


### 


### Create Print Transaction

POST http://localhost:3000/api/v1/transactions HTTP/1.1
Content-Type: application/json

{
  "printDocumentIds": [
    1,
    2
  ],
  "printerId": 1,
  "vendorId": 1
}


### 


### Get All Print Transactions

GET http://localhost:3000/api/v1/transactions HTTP/1.1
Accept: application/json


### 


### Get Print Transaction by ID

GET http://localhost:3000/api/v1/transactions/1 HTTP/1.1
Accept: application/json


### 


### Update Print Transaction by ID

PATCH http://localhost:3000/api/v1/transactions/1 HTTP/1.1
Content-Type: application/json

{
  "status": "PRINTING"
}


### 


### Delete Print Transaction by ID

DELETE http://localhost:3000/api/v1/transactions/1 HTTP/1.1
Accept: application/json


### 


### Create Print Document

POST http://localhost:3000/api/v1/documents HTTP/1.1
Content-Type: application/json

{
  "configuration": {
    "copies": 2,
    "duplex": false
  },
  "name": "Document 1",
  "path": "/documents/doc1.pdf"
}


### 


### Get All Print Documents

GET http://localhost:3000/api/v1/documents HTTP/1.1
Accept: application/json


### 


### Get Print Document by ID

GET http://localhost:3000/api/v1/documents/1 HTTP/1.1
Accept: application/json


### 


### Update Print Document by ID

PATCH http://localhost:3000/api/v1/documents/1 HTTP/1.1
Content-Type: application/json

{
  "name": "Updated Document 1"
}


### 


### Delete Print Document by ID

DELETE http://localhost:3000/api/v1/documents/1 HTTP/1.1
Accept: application/json


### 


### Upload File

POST http://localhost:3000/api/v1/files HTTP/1.1
Content-Type: application/json

{
  "contentType": "application/pdf",
  "filename": "file.pdf"
}


### 


### Download File

GET http://localhost:3000/api/v1/files HTTP/1.1
Content-Type: application/json

{
  "contentType": "application/pdf",
  "key": "file-key"
}

