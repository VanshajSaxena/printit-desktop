{
  "name": "printly",
  "description": "Printing Made Boring",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "author": {
    "email": "sayhi@vanshajsaxena.com",
    "name": "Vanshaj Saxena",
    "url": "https://vanshajsaxena.com"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach -R run build",
    "compile": "yarn build && electron-builder build --config electron-builder.cjs",
    "test": "yarn playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "yarn workspaces foreach -R run typecheck",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "yarn workspace @app/integrate-renderer start",
    "init": "yarn create-renderer && yarn integrate-renderer && yarn install"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "24.5.2",
    "create-vite": "7.1.3",
    "electron": "38.3.0",
    "electron-builder": "26.0.12",
    "eslint-plugin-react-dom": "^2.2.2",
    "eslint-plugin-react-x": "^2.2.2",
    "glob": "11.0.3",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@app/main": "workspace:*",
    "electron-log": "^5.4.3"
  },
  "packageManager": "yarn@4.10.3"
}
