{
  "name": "printit",
  "description": "Printit, Instantly.",
  "version": "0.0.3-beta",
  "private": true,
  "type": "module",
  "author": {
    "email": "sayhi@vanshajsaxena.com",
    "name": "Vanshaj Saxena",
    "url": "https://vanshajsaxena.com"
  },
  "main": "packages/entry-point.mjs",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "build": "yarn workspaces foreach --all --topological-dev run build",
    "compile": "electron-builder build --config electron-builder.cjs",
    "test": "yarn playwright test ./tests/e2e.spec.ts",
    "start": "node packages/dev-mode.js",
    "typecheck": "yarn workspaces foreach --all --topological-dev run typecheck",
    "create-renderer": "cd packages && node ./integrate-renderer/create-renderer.js",
    "integrate-renderer": "yarn workspace @app/integrate-renderer start",
    "init": "yarn create-renderer && yarn integrate-renderer && yarn install"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/node": "24.10.1",
    "create-vite": "7.1.3",
    "electron": "^39",
    "electron-builder": "26.3.5",
    "eslint-plugin-react-dom": "^2.5.0",
    "eslint-plugin-react-x": "^2.5.0",
    "glob": "11.1.0",
    "playwright": "^1.57.0",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "typescript": "^5.9.3"
  },
  "packageManager": "yarn@4.12.0"
}
