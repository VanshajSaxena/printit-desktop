{
  "name": "@app/renderer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base ./",
    "lint": "eslint .",
    "gen:cloud-api": "openapi-typescript ./src/api/printly-cloud-api-description.json --alphabetize --root-types --root-types-no-schema-prefix --output ./src/api/gen/cloud-api-types.ts",
    "update:cloud-api": "openapi-typescript http://localhost:3000/docs/json --alphabetize --root-types --root-types-no-schema-prefix --output ./src/api/gen/cloud-api-types.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/query-async-storage-persister": "^5.90.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-query-persist-client": "^5.90.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "idb-keyval": "^6.2.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.577.0",
    "openapi-fetch": "^0.15.0",
    "openapi-react-query": "^0.5.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.2",
    "eslint-plugin-react-dom": "^2.5.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-react-x": "^2.5.0",
    "globals": "^16.5.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "7.3.0"
  },
  "main": "./dist/index.html",
  "exports": {
    ".": {
      "default": "./dist/index.html"
    }
  }
}
