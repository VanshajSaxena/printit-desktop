{
  "name": "@app/common",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "gen"
  ],
  "scripts": {
    "gen:print-service-api": "openapi-typescript ./print-service-description.json --alphabetize --root-types --root-types-no-schema-prefix --output ./gen/types/print-service-api-types.ts",
    "gen:cloud-api": "openapi-typescript ./cloud-api-description.json --alphabetize  --root-types --root-types-no-schema-prefix --output ./gen/types/cloud-api-types.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "7.1.10",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0"
  }
}
