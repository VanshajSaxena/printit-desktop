{
  "name": "@app/common",
  "packageManager": "yarn@4.10.3",
  "scripts": {
    "gen:api-types": "openapi-typescript ./print-service-description.json --output ./gen/types/print-service-api.ts --root-types --root-types-no-schema-prefix",
    "gen:cloud-api": "openapi-typescript ./cloud-api-description.json --alphabetize --path-params-as-types  --make-paths-enum --empty-objects-unknown --output ./gen/types/cloud-api.ts --root-types --root-types-no-schema-prefix"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3"
  }
}
