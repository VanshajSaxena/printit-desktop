{
  "name": "@app/common",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "gen"
  ],
  "scripts": {
    "gen:print-service-api": "openapi-typescript ./print-service-description.json --output ./gen/types/print-service-api-types.ts",
    "gen:cloud-api": "openapi-typescript ./cloud-api-description.json --output ./gen/types/cloud-api-types.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "^0.15.0",
    "socket.io-client": "^4.7.2"
  },
  "devDependencies": {
    "openapi-typescript": "^7.10.1",
    "typescript": "^5.9.3",
    "vite": "7.2.7",
    "vite-plugin-dts": "^4.5.4"
  }
}
