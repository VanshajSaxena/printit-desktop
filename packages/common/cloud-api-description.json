  "info": {
    "title": "Printly",
    "description": "Printly Cloud API.",
    "version": "0.0.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateVendorDto": {
        "type": "object",
        "properties": {
          "firstname": { "type": "string" },
          "lastname": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "sub": { "type": "string" }
        },
        "required": ["firstname", "lastname", "email", "sub"]
      },
      "VendorResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "firstname": { "type": "string" },
          "lastname": { "type": "string" },
          "givenName": { "type": "string", "nullable": true },
          "urlId": { "type": "string" }
        },
        "required": ["id", "firstname", "lastname", "givenName", "urlId"]
      },
      "UpdateVendorDto": { "type": "object", "properties": {} },
      "CreatePrinterDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "capabilities": { "type": "string", "format": "json" },
          "vendorId": { "type": "number" }
        },
        "required": ["name", "capabilities", "vendorId"]
      },
      "PrinterResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "capabilities": { "type": "string" }
        },
        "required": ["id", "name", "capabilities"]
      },
      "UpdatePrinterDto": { "type": "object", "properties": {} },
      "CreatePrintTransactionDto": {
        "type": "object",
        "properties": {
          "vendorId": { "type": "number" },
          "printerId": { "type": "number" },
          "printDocumentIds": { "type": "array", "items": { "type": "number" } }
        },
        "required": ["vendorId", "printDocumentIds"]
      },
      "PrintDocument": { "type": "object", "properties": {} },
      "PrintTransactionResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "status": {
            "enum": ["PENDING", "QUEUED", "PRINTING", "COMPLETED", "ERROR"],
            "type": "string"
          },
          "friendlyId": { "type": "string" },
          "printDocuments": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/PrintDocument" }
          }
        },
        "required": ["id", "status", "friendlyId", "printDocuments"]
      },
      "UpdatePrintTransactionDto": { "type": "object", "properties": {} },
      "CreatePrintDocumentDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "configuration": { "type": "string", "format": "json" }
        },
        "required": ["name", "path"]
      },
      "PrintDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "status": {
            "enum": ["PENDING", "QUEUED", "PRINTING", "COMPLETED", "ERROR"],
            "type": "string"
          },
          "configuration": { "type": "string", "nullable": true }
        },
        "required": ["id", "name", "path", "status", "configuration"]
      },
      "UpdatePrintDocumentDto": { "type": "object", "properties": {} }
    }
  }
}
