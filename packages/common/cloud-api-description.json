  "info": {
    "title": "Printly",
    "description": "Printly Cloud API.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "CreateVendorDto": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 20,
            "pattern": "/^[a-zA-Z0-9_]+$/"
          },
          "givenName": { "type": "string" },
          "address": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        },
        "required": ["firstName", "lastName", "username", "email"]
      },
      "VendorResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "givenName": { "type": "string", "nullable": true },
          "username": { "type": "string" },
          "address": { "type": "string" },
          "slug": { "type": "string" }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "givenName",
          "username",
          "address",
          "slug"
        ]
      },
      "UpdateVendorDto": { "type": "object", "properties": {} },
      "CreatePrinterDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "capabilities": { "type": "string", "format": "json" },
          "vendorId": { "type": "number" }
        },
        "required": ["name", "capabilities", "vendorId"]
      },
      "PrinterResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "name": { "type": "string" },
          "capabilities": { "type": "string", "format": "json" }
        },
        "required": ["id", "name", "capabilities"]
      },
      "UpdatePrinterDto": { "type": "object", "properties": {} },
      "CreateJobDto": {
        "type": "object",
        "properties": {
          "documentId": { "type": "number" },
          "outputColor": {
            "enum": ["COLOR", "MONOCHROME", "GRAYSCALE"],
            "type": "string"
          },
          "copyCount": { "type": "number" }
        },
        "required": ["documentId", "outputColor", "copyCount"]
      },
      "CreateTransactionDto": {
        "type": "object",
        "properties": {
          "vendorId": { "type": "number" },
          "printerId": { "type": "number" },
          "jobs": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CreateJobDto" }
          }
        },
        "required": ["vendorId", "jobs"]
      },
      "TransactionResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "status": {
            "enum": ["PENDING", "QUEUED", "PRINTING", "COMPLETED", "ERROR"],
            "type": "string"
          },
          "friendlyId": { "type": "string" }
        },
        "required": ["id", "status", "friendlyId"]
      },
      "UpdateTransactionDto": { "type": "object", "properties": {} },
      "CreateDocumentDto": {
        "type": "object",
        "properties": {
          "filename": { "type": "string" },
          "contentType": { "type": "string" }
        },
        "required": ["filename", "contentType"]
      },
      "CreateDocumentResponseDto": {
        "type": "object",
        "properties": {
          "id": { "type": "number" },
          "filename": { "type": "string" },
          "contentType": { "type": "string" }
        },
        "required": ["id", "filename", "contentType"]
      },
      "UpdateDocumentDto": { "type": "object", "properties": {} },
      "JobResponseDto": {
        "type": "object",
        "properties": { "id": { "type": "number" } },
        "required": ["id"]
      },
      "UpdateJobDto": {
        "type": "object",
        "properties": {
          "documentId": { "type": "number" },
          "outputColor": {
            "type": "string",
            "enum": ["COLOR", "MONOCHROME", "GRAYSCALE"]
          },
          "copyCount": { "type": "number" }
        }
      },
      "UploadFileBatchRequestDto": {
        "type": "object",
        "properties": {
          "ids": { "type": "array", "items": { "type": "number" } }
        },
        "required": ["ids"]
      },
      "UploadFileResponseDto": {
        "type": "object",
        "properties": {
          "url": { "type": "string" },
          "id": { "type": "number" }
        },
        "required": ["url", "id"]
      },
      "UploadFileBatchResponseDto": {
        "type": "object",
        "properties": {
          "signedUrls": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UploadFileResponseDto" }
          }
        },
        "required": ["signedUrls"]
      },
      "DownloadFileRequestDto": {
        "type": "object",
        "properties": {
          "key": { "type": "string" },
          "contentType": { "type": "string" }
        },
        "required": ["key"]
      },
      "DownloadFileResponseDto": {
        "type": "object",
        "properties": { "url": { "type": "string" } },
        "required": ["url"]
      }
    }
  }
}
